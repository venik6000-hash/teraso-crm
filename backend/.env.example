# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
POSTGRES_PORT=54329
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/teraso_crm?schema=public"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
POSTGRES_TEST_PORT=54330
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/teraso_crm_test?schema=public"

# Idempotent local administrator seed. Leave the password empty for a locked
# admin, or set 8-128 characters locally before `bun run prisma:seed`.
# Production backend-initial spec generation requires 12-128 non-placeholder
# characters and exposes these values only to the PRE_DEPLOY job.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD=""

JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:19006"
# Public browser-app origin used in transactional links such as password reset.
WEBAPP_ORIGIN="http://localhost:5173"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_REUSE_GRACE_SECONDS="10"
SESSION_ABSOLUTE_TTL_DAYS="90"
SESSION_RETENTION_DAYS="7"
AUTH_BODY_LIMIT_BYTES="65536"
AUTH_RATE_LIMIT_MAX="60"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"

# Teraso site webhook (POST /api/crm/inbound/quiz). The site signs each delivery
# with HMAC-SHA256 over "<x-teraso-timestamp>.<raw JSON body>" using this secret,
# which is server-only (PRD 10) and never sent to the browser.
#
# This secret authenticates the only unauthenticated public write endpoint in the
# system, so it must be GENERATED, never typed:
#     openssl rand -hex 32
# Leave it empty to keep the endpoint fail-closed (every delivery is rejected with
# 401) — that is the correct setting until the site integration is wired up. Any
# non-empty value must be at least 32 characters in every environment, and in
# production must be a generated 64+ character hex secret: a short or memorable
# value fails at boot, because an attacker who captures one legitimate delivery can
# brute-force a weak key offline and then inject arbitrary signed leads.
#
# MAX_AGE_SECONDS rejects stale signatures; the site recomputes the signature with a
# fresh timestamp on every retry, so redelivery after a longer outage still
# succeeds. BODY_LIMIT_BYTES caps the raw payload.
TERASO_WEBHOOK_SECRET=""
TERASO_WEBHOOK_MAX_AGE_SECONDS="300"
TERASO_WEBHOOK_BODY_LIMIT_BYTES="65536"

# Browser push notifications (PRD 7.7). Generate one pair, once, and keep it:
#     cd backend && bunx web-push generate-vapid-keys
#
# All three are server-only. Only the PUBLIC key is ever served to a browser, and
# only through the authenticated GET /api/notifications/vapid-public-key; the
# private key never leaves the process that signs (PRD 10). Store both halves as
# deployment secrets, never in the repository.
#
# Leaving the group empty is the correct setting until the PWA of Task 8 is wired
# up: the CRM still records every notification and the in-app centre remains the
# source of truth — the sends are simply marked SKIPPED. Setting only some of the
# three, or truncating a key, fails at boot rather than silently failing to sign.
#
# VAPID_SUBJECT identifies the sender to the push service: a mailto: address or an
# https URL a push operator can use to reach you about a misbehaving deployment.
VAPID_SUBJECT=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# How many minutes an unfinished task waits past its due time before a SECOND,
# «Просроченная задача» notification is sent. The first one goes out at the due
# time itself; this is the nag that follows if the task is still open.
#
# This is server configuration, NOT a setting inside the CRM: change the number
# here and restart the backend for it to take effect. There is no screen for it.
# Raise it if the follow-up feels naggy, lower it if things slip through. Default
# is 15; the maximum is 1440 (a day), because the dispatcher only looks 24 hours
# back and a longer delay would quietly mean "never".
NOTIFICATION_TASK_OVERDUE_AFTER_MINUTES="15"
SHUTDOWN_GRACE_SECONDS="20"
TRUST_PROXY="false"
# Required when TRUST_PROXY=true. Use do-connecting-ip on DigitalOcean App Platform.
# For a comma-separated proxy chain, set first or last to match the provider contract.
# TRUSTED_PROXY_CLIENT_IP_HEADER="do-connecting-ip"
# TRUSTED_PROXY_CLIENT_IP_POSITION="first"
COOKIE_SECURE="false"

# Optional DigitalOcean Spaces storage. Leave blank until the product needs
# uploads, media, or other persistent files.
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_ENDPOINT=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
SPACES_UPLOAD_MAX_BYTES="10485760"
SPACES_UPLOAD_URL_TTL_SECONDS="900"
SPACES_DOWNLOAD_URL_TTL_SECONDS="300"
SPACES_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"
